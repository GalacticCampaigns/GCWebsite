{
  "scout": {
    "auto_scan_pattern": "ch|chapter|prelude",
    "ignore_keywords": ["ooc", "out of character", "gm", "staff", "test"],
    "forum_is_chapter": true
  },
  "refinery": {
    "truncation_limit": 100,
    "content_scan_version": 4
  },
  "forensics": {
    "nsfw_threshold": 0.90,
    "nsfw_keywords": ["nsfw", "🔞", "underage", "18+"],
    "narrative_types": [0, 19, 21],
    "tags": {
      "action": {
        "keywords": ["action", "battle", "fight", "combat"],
        "emoji": "⚔️",
        "threshold": 0.90
      },
      "lore": {
        "keywords": ["lore", "history", "background", "worldbuilding"],
        "emoji": "📜",
        "threshold": 0.90
      },
      "pinned": {
        "keywords": ["pinned", "important", "reference"],
        "emoji": "📌",
        "threshold": 0.90
      }   
    }
  },
  "discord": {
    "api_version": "v10"
  },
  "git_aliases": {
    "alicia86": "github.com-alicia86",
    "GalacticCampaigns": "github.com-alicia86"
  }
}
